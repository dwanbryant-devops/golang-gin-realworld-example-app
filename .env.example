# Server Configuration
PORT=8080
GIN_MODE=debug

# Database: set DATABASE_URL for Postgres; otherwise SQLite at DB_PATH is used.
# DATABASE_URL=postgres://user:pass@localhost:5432/realworld?sslmode=disable
DB_PATH=./data/gorm.db

# JWT signing key. Required when GIN_MODE=release; a dev default is used otherwise.
# JWT_SECRET=change-me

# Optional cache (Valkey/Redis). Unset = no cache.
# REDIS_URL=redis://localhost:6379/0

# Test Database Path (optional, for running tests)
# TEST_DB_PATH=./data/gorm_test.db
